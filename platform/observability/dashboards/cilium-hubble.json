{
  "uid": "agent-rca-cilium-hubble",
  "title": "Agent RCA · Cilium & Hubble",
  "description": "Cluster-scoped Cilium and Hubble operational telemetry for the fault target. Metrics are observations, not RCA verdicts.",
  "tags": [
    "agent-rca",
    "cilium",
    "hubble",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=~\".*(cilium|hubble).*\",cluster_id!=\"\"}, cluster_id)",
        "query": {
          "query": "label_values(up{job=~\".*(cilium|hubble).*\",cluster_id!=\"\"}, cluster_id)",
          "refId": "cluster"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "agent-rca-chaos-eval",
          "value": "agent-rca-chaos-eval"
        }
      }
