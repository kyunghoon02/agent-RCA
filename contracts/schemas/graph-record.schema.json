{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:graph-record",
  "title": "Domain-neutral Temporal StateGraph Record",
  "oneOf": [
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/snapshotInterval"
    },
    {
      "$ref": "#/$defs/relationInterval"
    },
    {
      "$ref": "#/$defs/eventAggregate"
    }
  ],
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[a-z0-9][a-z0-9-]{7,63}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "entity_id",
        "entity_type",
        "domain",
        "name",
        "scope",
        "external_ref",
        "exists",
        "first_seen_at",
        "last_seen_at",
        "evidence_ids"
      ],
      "properties": {
        "record_type": {
          "const": "entity"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object"
        },
        "external_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "type": "boolean"
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "snapshotInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "snapshot_id",
        "entity_id",
        "observed_at",
        "valid_from",
        "valid_to",
        "state_hash",
        "state",
        "evidence_ids"
      ],
      "properties": {
        "record_type": {
          "const": "snapshot_interval"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^snap-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "state_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state": {
          "type": "object"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "relationInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "relation_id",
        "relation_key",
        "source_entity_id",
        "relation_type",
        "destination_entity_id",
        "reference_key",
        "projector",
        "observed_at",
        "valid_from",
        "valid_to",
        "evidence_ids"
      ],
      "properties": {
        "record_type": {
          "const": "relation_interval"
        },
        "relation_id": {
          "type": "string",
          "pattern": "^rel-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "relation_key": {
          "type": "string",
          "pattern": "^relkey-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "source_entity_id": {
          "type": "string",
          "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "relation_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "destination_entity_id": {
          "type": "string",
          "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "reference_key": {
          "type": "string",
          "minLength": 1
        },
        "projector": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "eventAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "event_id",
        "entity_id",
        "event_type",
        "first_seen_at",
        "last_seen_at",
        "count",
        "attributes",
        "evidence_ids"
      ],
      "properties": {
        "record_type": {
          "const": "event_aggregate"
        },
        "event_id": {
          "type": "string",
          "pattern": "^evt-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "attributes": {
          "type": "object"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    }
  }
}
