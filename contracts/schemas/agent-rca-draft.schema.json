{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:agent-rca-draft",
  "title": "Agent RCA Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "incident_id", "context_id", "decision",
    "root_cause", "hypotheses", "remediation", "limitations", "read_only"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "incident_id": {"type": "string", "pattern": "^inc-[a-z0-9][a-z0-9-]{7,63}$"},
    "context_id": {"type": "string", "pattern": "^ctx-[a-z0-9][a-z0-9-]{7,63}$"},
    "decision": {"enum": ["CONCLUSIVE", "INCONCLUSIVE", "PARTIAL"]},
    "root_cause": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/rootCause"}
      ]
    },
    "hypotheses": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "remediation": {"$ref": "#/$defs/remediation"},
    "limitations": {
      "type": "array", "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "read_only": {"const": true}
  },
  "$defs": {
    "evidenceIds": {
      "type": "array", "uniqueItems": true, "maxItems": 100,
      "items": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]{7,63}$"}
    },
    "referenceIds": {
      "type": "array", "uniqueItems": true, "maxItems": 20,
      "items": {"type": "string", "pattern": "^ref-[a-z0-9][a-z0-9-]{7,63}$"}
    },
    "rootCause": {
      "type": "object", "additionalProperties": false,
      "required": [
        "summary", "entity_id", "supporting_evidence_ids",
        "contradicting_evidence_ids", "reference_document_ids"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "entity_id": {"type": "string", "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"},
        "supporting_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "contradicting_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "reference_document_ids": {"$ref": "#/$defs/referenceIds"}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": [
        "rank", "summary", "entity_id", "confidence", "status",
        "supporting_evidence_ids", "contradicting_evidence_ids",
        "reference_document_ids", "missing_evidence"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 5},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "entity_id": {"type": "string", "pattern": "^ent-[a-z0-9][a-z0-9-]{7,127}$"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["supported", "competing", "rejected", "unresolved"]},
        "supporting_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "contradicting_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "reference_document_ids": {"$ref": "#/$defs/referenceIds"},
        "missing_evidence": {
          "type": "array", "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "remediation": {
      "type": "object", "additionalProperties": false,
      "required": ["suggestions", "verification_conditions"],
      "properties": {
        "suggestions": {
          "type": "array", "maxItems": 10,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "verification_conditions": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "CONCLUSIVE"}}},
      "then": {"properties": {"root_cause": {"$ref": "#/$defs/rootCause"}}}
    },
    {
      "if": {"properties": {"decision": {"const": "INCONCLUSIVE"}}},
      "then": {"properties": {"root_cause": {"type": "null"}}}
    }
  ]
}
