{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:rca-evaluation-agent-runtime",
  "title": "RCA Evaluation Agent Runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_case_id",
    "scenario_id",
    "incident_id",
    "variant_id",
    "model",
    "agent_status",
    "reason_code",
    "knowledge_status",
    "received_at",
    "started_at",
    "completed_at",
    "report_generated_at",
    "report_status",
    "prediction_outcome",
    "ingest_to_agent_start_ms",
    "ingest_to_terminal_ms",
    "ingest_to_report_ms",
    "usage"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evaluation_case_id": {
      "type": "string",
      "pattern": "^eval-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^scenario-[a-z0-9][a-z0-9-]{7,95}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "variant_id": {"const": "C"},
    "model": {"type": "string", "minLength": 1, "maxLength": 100},
    "agent_status": {
      "enum": [
        "SUCCEEDED",
        "GATE_REJECTED",
        "MODEL_FAILED",
        "BUDGET_EXHAUSTED"
      ]
    },
    "reason_code": {
      "enum": [
        "REPORT_ACCEPTED",
        "EVIDENCE_GATE_REJECTED",
        "MODEL_EXECUTION_FAILED",
        "MODEL_BUDGET_EXCEEDED"
      ]
    },
    "knowledge_status": {
      "enum": ["SUCCEEDED", "NO_MATCH", "STALE_ONLY", "FAILED", "TIMED_OUT"]
    },
    "received_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "report_generated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "report_status": {
      "type": ["string", "null"],
      "enum": ["conclusive", "inconclusive", "partial", null]
    },
    "prediction_outcome": {
      "enum": ["ROOT_CAUSE", "ABSTAIN", "AMBIGUOUS", "FAILED"]
    },
    "ingest_to_agent_start_ms": {"type": "integer", "minimum": 0},
    "ingest_to_terminal_ms": {"type": "integer", "minimum": 0},
    "ingest_to_report_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llm_calls",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "wall_time_ms"
      ],
      "properties": {
        "llm_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
