{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:rca-report",
  "title": "RCA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "incident_id",
    "context_id",
    "path",
    "status",
    "generated_at",
    "root_cause",
    "hypotheses",
    "remediation",
    "budget",
    "read_only",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^rpt-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^ctx-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "path": {
      "enum": [
        "fast",
        "normal",
        "deep"
      ]
    },
    "status": {
      "enum": [
        "conclusive",
        "inconclusive",
        "partial"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "root_cause": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "entity",
            "supporting_evidence_ids",
            "reference_document_ids"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "entity": {
              "$ref": "urn:agent-rca:schema:entity-ref"
            },
            "supporting_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reference_document_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ref-[a-z0-9][a-z0-9-]{7,63}$"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "summary",
          "entity",
          "confidence",
          "status",
          "supporting_evidence_ids",
          "contradicting_evidence_ids",
          "reference_document_ids",
          "missing_evidence"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "entity": {
            "$ref": "urn:agent-rca:schema:entity-ref"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "enum": [
              "supported",
              "competing",
              "rejected",
              "unresolved"
            ]
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "contradicting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reference_document_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ref-[a-z0-9][a-z0-9-]{7,63}$"
            },
            "uniqueItems": true
          },
          "missing_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestions",
        "verification_conditions"
      ],
      "properties": {
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "llm_calls",
        "tool_calls",
        "tree_depth",
        "wall_time_ms",
        "exhausted"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "llm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tree_depth": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "exhausted": {
          "type": "boolean"
        }
      }
    },
    "read_only": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
