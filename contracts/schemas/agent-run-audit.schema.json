{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:agent-run-audit",
  "title": "Agent Run Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "agent_run_id", "incident_id", "context_id",
    "knowledge_audit_id", "knowledge_status", "model", "status", "reason_code",
    "started_at", "completed_at", "budget", "usage", "tool_events",
    "retrieved_reference_ids", "inspected_evidence_ids",
    "inspected_reference_document_ids", "cited_evidence_ids",
    "cited_reference_document_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "agent_run_id": {"type": "string", "pattern": "^arun-[a-z0-9][a-z0-9-]{7,63}$"},
    "incident_id": {"type": "string", "pattern": "^inc-[a-z0-9][a-z0-9-]{7,63}$"},
    "context_id": {"type": "string", "pattern": "^ctx-[a-z0-9][a-z0-9-]{7,63}$"},
    "knowledge_audit_id": {"type": "string", "pattern": "^kaud-[a-z0-9][a-z0-9-]{7,63}$"},
    "knowledge_status": {"enum": ["SUCCEEDED", "NO_MATCH", "STALE_ONLY", "FAILED", "TIMED_OUT"]},
    "model": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"enum": ["SUCCEEDED", "GATE_REJECTED", "MODEL_FAILED", "BUDGET_EXHAUSTED"]},
    "reason_code": {
      "enum": [
        "REPORT_ACCEPTED", "EVIDENCE_GATE_REJECTED",
        "MODEL_EXECUTION_FAILED", "MODEL_BUDGET_EXCEEDED",
        "GATE_DRAFT_CONTRACT_INVALID", "GATE_INCIDENT_MISMATCH",
        "GATE_CONTEXT_MISMATCH", "GATE_UNKNOWN_EVIDENCE_CITATION",
        "GATE_UNINSPECTED_EVIDENCE_CITATION",
        "GATE_UNKNOWN_REFERENCE_CITATION",
        "GATE_UNINSPECTED_REFERENCE_CITATION", "GATE_ENTITY_OUT_OF_SCOPE",
        "GATE_HYPOTHESIS_RANK_INVALID", "GATE_HYPOTHESIS_SUPPORT_MISSING",
        "GATE_ROOT_LEADING_MISMATCH",
        "GATE_PROOF_INSUFFICIENT", "GATE_CONCLUSIVE_ROOT_MISSING",
        "GATE_CONCLUSIVE_SUPPORT_MISSING", "GATE_CONTRADICTING_EVIDENCE",
        "GATE_CHANNELS_INSUFFICIENT", "GATE_CONTEXT_INCOMPLETE",
        "GATE_CONCLUSIVE_COLLECTOR_FAILURE", "GATE_ROOTLESS_REMEDIATION",
        "GATE_INVESTIGATION_BUDGET_EXCEEDED"
      ]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "budget": {"$ref": "#/$defs/budget"},
    "candidate_evidence_ids": {"$ref": "#/$defs/candidateEvidenceIds"},
    "input_projection": {"$ref": "#/$defs/inputProjection"},
    "usage": {"$ref": "#/$defs/usage"},
    "tool_events": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/toolEvent"}
    },
    "retrieved_reference_ids": {"$ref": "#/$defs/referenceIds"},
    "inspected_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
    "inspected_reference_document_ids": {"$ref": "#/$defs/referenceIds"},
    "cited_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
    "cited_reference_document_ids": {"$ref": "#/$defs/referenceIds"}
  },
  "$defs": {
    "evidenceIds": {
      "type": "array", "uniqueItems": true, "maxItems": 100,
      "items": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]{7,63}$"}
    },
    "referenceIds": {
      "type": "array", "uniqueItems": true, "maxItems": 20,
      "items": {"type": "string", "pattern": "^ref-[a-z0-9][a-z0-9-]{7,63}$"}
    },
    "candidateEvidenceIds": {
      "type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 12,
      "items": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]{7,63}$"}
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_turns", "max_llm_calls", "max_tool_calls", "max_output_tokens", "max_wall_time_ms"],
      "properties": {
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_llm_calls": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_evidence_candidates": {"type": "integer", "minimum": 2, "maximum": 12},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 8000},
        "max_wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 180000}
      }
    },
    "inputProjection": {
      "type": "object", "additionalProperties": false,
      "required": [
        "total_context_evidence", "candidate_evidence", "total_state_paths",
        "included_state_paths", "serialized_bytes"
      ],
      "properties": {
        "total_context_evidence": {"type": "integer", "minimum": 1},
        "candidate_evidence": {"type": "integer", "minimum": 1, "maximum": 12},
        "total_state_paths": {"type": "integer", "minimum": 0},
        "included_state_paths": {"type": "integer", "minimum": 0, "maximum": 12},
        "serialized_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["llm_calls", "tool_calls", "input_tokens", "output_tokens", "total_tokens", "wall_time_ms"],
      "properties": {
        "llm_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0}
      }
    },
    "toolEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "tool_name", "requested_id", "status", "result_hash"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
        "tool_name": {"enum": ["inspect_evidence", "inspect_reference"]},
        "requested_id": {
          "type": "string",
          "pattern": "^((ev|ref)-[a-z0-9][a-z0-9-]{7,127}|E([1-9]|1[0-2]))$"
        },
        "status": {"enum": ["SUCCEEDED", "DENIED", "NOT_FOUND", "BUDGET_EXHAUSTED"]},
        "result_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
