{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:network-dependency-path",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path_id",
    "source_service",
    "destination_service",
    "destination_port",
    "protocol",
    "client_operation"
  ],
  "properties": {
    "path_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "source_service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "destination_service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "destination_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "protocol": {
      "enum": [
        "TCP"
      ]
    },
    "client_operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f]+$"
    }
  }
}
