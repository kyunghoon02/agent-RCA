{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rca:schema:network-path-evidence",
  "allOf": [
    {
      "$ref": "urn:agent-rca:schema:evidence-item"
    },
    {
      "properties": {
        "subject": {
          "properties": {
            "kind": {
              "const": "Service"
            },
            "uid": {
              "type": "null"
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "cluster_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cluster_id"
          ]
        },
        "quality": {
          "properties": {
            "freshness": {
              "enum": [
                "live",
                "recent"
              ]
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "source": {
              "const": "hubble"
            },
            "kind": {
              "const": "network-flow-summary"
            },
            "provenance": {
              "properties": {
                "provider": {
                  "const": "hubble-network-path-provider"
                }
              }
            },
            "facts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feature_set",
                "path_id",
                "source_service",
                "destination_service",
                "destination_port",
                "protocol",
                "client_operation",
                "policy_denied_count",
                "first_denied_at",
                "last_denied_at",
                "truncated",
                "observation_gaps",
                "retention_status",
                "denied_at"
              ],
              "properties": {
                "feature_set": {
                  "const": "network-dependency-path-v1"
                },
                "path_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                },
                "source_service": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "destination_service": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "destination_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "protocol": {
                  "enum": [
                    "TCP"
                  ]
                },
                "client_operation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f]+$"
                },
                "policy_denied_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "first_denied_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "last_denied_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "truncated": {
                  "type": "boolean"
                },
                "observation_gaps": {
                  "type": "array",
                  "maxItems": 9,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "FLOW_EVENTS_LOST",
                      "RELAY_NODE_UNAVAILABLE",
                      "RELAY_NODE_ERROR",
                      "RELAY_NODE_GONE",
                      "RELAY_NODE_STATE_UNKNOWN",
                      "CLI_DIAGNOSTIC",
                      "CLI_RELAY_VERSION_MISMATCH",
                      "RELAY_QUERY_UNAVAILABLE",
                      "QUERY_BUDGET_EXHAUSTED"
                    ]
                  }
                },
                "retention_status": {
                  "const": "UNKNOWN"
                },
                "denied_at": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "source": {
              "const": "prometheus"
            },
            "kind": {
              "const": "metric-summary"
            },
            "provenance": {
              "properties": {
                "provider": {
                  "const": "prometheus-network-path-provider"
                }
              }
            },
            "facts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feature_set",
                "path_id",
                "source_service",
                "destination_service",
                "destination_port",
                "protocol",
                "client_operation",
                "sample_count",
                "error_samples",
                "telemetry_warnings"
              ],
              "properties": {
                "feature_set": {
                  "const": "network-dependency-path-v1"
                },
                "path_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                },
                "source_service": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "destination_service": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "destination_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "protocol": {
                  "enum": [
                    "TCP"
                  ]
                },
                "client_operation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f]+$"
                },
                "sample_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "telemetry_warnings": {
                  "type": "boolean"
                },
                "error_samples": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "at",
                      "errors"
                    ],
                    "properties": {
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "errors": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
