# Read-only Viewer query API. When unset the Viewer runs on deterministic
# fixtures and labels every screen as "Demo Data".
NEXT_PUBLIC_VIEWER_API_BASE_URL=

# Server-only BFF configuration. Never rename these to NEXT_PUBLIC_*.
# For local live verification, point the origin at a kubectl/SSH port-forward.
VIEWER_API_ORIGIN=http://127.0.0.1:18080
VIEWER_API_TOKEN=

# Environment label shown in the global header (e.g. local, staging, prod).
NEXT_PUBLIC_VIEWER_ENVIRONMENT=local

# Optional deep links. Each is rendered only when set, and only when the URL
# passes the https/http allowlist check in src/lib/config.ts.
NEXT_PUBLIC_GRAFANA_URL=
NEXT_PUBLIC_LOKI_URL=
NEXT_PUBLIC_TEMPO_URL=
